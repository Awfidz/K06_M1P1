        <rdfs:range rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Ronde"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memilikiPemainKalah -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memilikiPemainKalah">
