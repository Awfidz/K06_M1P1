        <rdfs:range rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Pemain"/>
        <rdfs:comment>R12, R13: Relasi invers dari kalahPadaSet yang menunjukkan pemain yang kalah pada suatu Set.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memilikiSenjataBawaan -->

