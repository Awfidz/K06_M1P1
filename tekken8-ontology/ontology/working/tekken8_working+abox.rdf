    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#AktivitasHeatBurst -->

    <owl:Class rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#AktivitasHeatBurst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Serangan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#mengaktifkanKondisi"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#HeatState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menghasilkanDamage"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#RecoverableDamage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menghasilkanDamage"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#RecoverableDamage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#AktivitasHeatEngager -->

