                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>R18: Merepresentasikan pemain yang memenuhi kondisi penalti terkait penggunaan senjata tajam bawaan karakter.</rdfs:comment>
    </owl:Class>
    


