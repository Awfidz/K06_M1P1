    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menggunakanSenjataKarakter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menggunakanSenjataKarakter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Pemain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Senjata"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menggunakanKarakter"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memilikiSenjataBawaan"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>R18: Menyimpulkan hubungan pemain dengan senjata melalui karakter yang digunakannya dan senjata bawaan karakter tersebut.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#menghasilkanDamage -->

