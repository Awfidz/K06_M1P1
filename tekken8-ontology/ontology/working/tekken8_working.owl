    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#kalahPadaSet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#kalahPadaSet">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memilikiPemainKalah"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Pemain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#Set"/>
        <rdfs:comment>R12, R13: Merepresentasikan hubungan pemain dengan Set yang dikalahkannya. Relasi ini digunakan untuk memodelkan syarat pergantian karakter dan kelayakan coaching setelah Set sebelumnya.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#memakaiProperti -->

