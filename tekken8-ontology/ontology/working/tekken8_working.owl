        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#mengaktifkanKondisi"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/K06-tekken8/ontologies/2026/10/tekken8-tournament-ontology#RageState"/>
            </owl:Restriction>
